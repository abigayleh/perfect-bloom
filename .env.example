# Copy to .env and fill in. .env is gitignored — never commit real keys.

ENV=dev
# Required outside dev. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=sqlite+aiosqlite:///./perfect_bloom.db

# fake | plantnet — "fake" needs no key and never touches the network.
IDENTIFY_PROVIDER=fake
PLANTNET_API_KEY=
PERENUAL_API_KEY=
